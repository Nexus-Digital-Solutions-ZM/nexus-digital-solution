    .project-link {
      display: inline-flex; align-items: center; gap: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.62rem; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--navy);
      background: var(--cyan); padding: 0.5rem 1rem;
      text-decoration: none;
      clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 6px 100%, 0 calc(100% - 6px));
      transition: var(--trans);
      border: none; cursor: pointer;
    }
    .project-link:hover { background: var(--gold); }
    .project-link svg { transition: transform var(--trans); }
    .project-link:hover svg { transform: translateX(3px); }

    /* ── CASE STUDY PANEL ── */
    .case-study-section { padding: 0 0 6rem; }
    .case-study-panel {
      background: var(--glass);
      border: 1px solid var(--border);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
      position: relative; overflow: hidden;
    }
    .case-study-panel::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--cyan), var(--gold), var(--cyan));
      background-size: 200% 100%;
      animation: shimmer 4s linear infinite;
    }
    @keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }

    .case-study-header {
      padding: 2rem 2.5rem;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 1rem;
      flex-wrap: wrap;
    }
    .case-study-title-group { flex: 1; }
    .case-study-label {
      font-family: var(--font-mono);
      font-size: 0.58rem; letter-spacing: 0.2em;
      color: var(--cyan); text-transform: uppercase; margin-bottom: 0.35rem;
    }
    .case-study-label::before { content: '// '; }
    .case-study-name {
      font-family: var(--font-mono);
      font-size: 1.1rem; font-weight: 700;
      color: var(--white); letter-spacing: 0.03em;
    }
    .case-live-badge {
      display: flex; align-items: center; gap: 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.6rem; letter-spacing: 0.12em;
      text-transform: uppercase;
      background: rgba(34,197,94,0.1);
      border: 1px solid rgba(34,197,94,0.3);
      color: #22c55e; padding: 0.4rem 0.875rem;
    }
    .case-live-badge.amber {
      background: rgba(240,160,48,0.1);
      border: 1px solid rgba(240,160,48,0.3);
      color: var(--gold-bright);
    }
    .case-live-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 8px rgba(34,197,94,0.6);
      animation: statusPulse 2s ease-in-out infinite;
    }
    .case-live-dot.amber {
      background: var(--gold);
      box-shadow: 0 0 8px rgba(240,160,48,0.6);
    }

    /* case study body grid */
    .case-study-body {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 0; background: var(--border);
      border-top: 1px solid var(--border);
    }
    .case-col {
      background: var(--navy);
      padding: 2rem;
    }
    .case-col-label {
      font-family: var(--font-mono);
      font-size: 0.58rem; letter-spacing: 0.18em;
      text-transform: uppercase; color: var(--cyan);
      margin-bottom: 1.25rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 0.5rem;
    }
    .case-col-label::before { content: '◆'; color: var(--gold); font-size: 0.4rem; }

    .case-item {
      display: flex; align-items: flex-start; gap: 0.6rem;
      margin-bottom: 0.75rem;
      font-size: 0.85rem; color: var(--muted); line-height: 1.6;
    }
    .case-item::before {
      content: '→';
      color: var(--cyan); font-family: var(--font-mono);
      font-size: 0.7rem; flex-shrink: 0; margin-top: 2px;
    }

    .case-result {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 0.75rem;
      border: 1px solid var(--border);
      margin-bottom: 0.5rem;
      background: rgba(0,200,232,0.03);
      transition: var(--trans);
    }
    .case-result:hover { border-color: var(--cyan); background: var(--cyan-dim); }
    .case-result-icon { color: var(--gold); font-size: 0.9rem; flex-shrink: 0; }
    .case-result-text {
      font-size: 0.83rem; color: var(--muted); line-height: 1.5;
    }
    .case-result-text strong { color: var(--white); font-weight: 500; display: block; font-size: 0.78rem; }

    /* stack in case study */
    .case-stack { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.5rem; }

    /* ── CTA IN WORK PAGE ── */
    .work-cta {
      padding: 5rem 0;
      border-top: 1px solid var(--border);
      position: relative; overflow: hidden;
      text-align: center;
    }
    .work-cta::before {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(ellipse at center, rgba(0,200,232,0.05) 0%, transparent 70%);
    }

    /* ── NAV ACTIVE STATE ── */
    .nav-links a.nx-nav-active {
      color: var(--cyan) !important;
      border-color: var(--border) !important;
      background: var(--cyan-dim) !important;
    }

    /* ── RESPONSIVE WORK PAGE ── */
    @media (max-width: 900px) {
      .case-study-body { grid-template-columns: 1fr; }
      .projects-grid { grid-template-columns: 1fr; }
      .case-study-header { flex-direction: column; align-items: flex-start; }
    }
    @media (max-width: 600px) {
      .project-metrics { grid-template-columns: repeat(3,1fr); }
      .case-study-header { padding: 1.5rem; }
      .case-col { padding: 1.5rem; }
    }
  </style>
</head>
