<script>
(function() {
  'use strict';

  /* ═══════════════════════════════════
     PAGE SWITCHING
  ═══════════════════════════════════ */
  var currentPage = 'home';

  window.showPage = function(page) {
    // hide all pages
    var pages = document.querySelectorAll('.nx-page');
    pages.forEach(function(p) { p.classList.remove('nx-active'); });

    // show target
    var target = document.getElementById('nx-' + page);
    if (target) {
      target.classList.add('nx-active');
      currentPage = page;
    }

    // update nav active state
    document.querySelectorAll('.nav-links a').forEach(function(a) {
      a.classList.remove('nx-nav-active');
    });
    var navEl = document.getElementById('nav-' + page);
    if (navEl) navEl.classList.add('nx-nav-active');

    // scroll to top
    window.scrollTo({ top: 0, behavior: 'smooth' });

    // re-trigger fade-up animations on work page
    if (page === 'work') {
      setTimeout(function() {
        document.querySelectorAll('#nx-work .fade-up').forEach(function(el) {
          el.classList.remove('visible');
          void el.offsetWidth; // reflow
        });
        var obs = new IntersectionObserver(function(entries) {
          entries.forEach(function(e) {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              obs.unobserve(e.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });
        document.querySelectorAll('#nx-work .fade-up').forEach(function(el) {
          obs.observe(el);
        });
      }, 50);
    }

    // GA page view tracking
    if (typeof gtag !== 'undefined') {
      gtag('event', 'page_view', { page_title: page, page_path: '/' + page });
    }
  };

  /* scroll to section within home page */
  window.scrollToSection = function(id) {
    // make sure home is showing first
    if (currentPage !== 'home') {
      showPage('home');
      setTimeout(function() {
        var el = document.getElementById(id);
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 120);
    } else {
      var el = document.getElementById(id);
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  };

  /* ── Navbar scroll ── */
  var navbar = document.getElementById('navbar');
  var lastScroll = 0;
  window.addEventListener('scroll', function() {
    var y = window.scrollY;
    navbar.classList.toggle('scrolled', y > 40);
    lastScroll = y;
  }, { passive: true });

  /* ── Mobile nav ── */
  var hamburger = document.getElementById('hamburger');
  var mobileNav = document.getElementById('mobileNav');
  var mobileClose = document.getElementById('mobileClose');

  function openMenu() {
    mobileNav.classList.add('open');
    hamburger.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  window.closeMenu = function() {
    mobileNav.classList.remove('open');
    hamburger.classList.remove('open');
    document.body.style.overflow = '';
  };

  hamburger.addEventListener('click', openMenu);
  hamburger.addEventListener('keydown', function(e) { if(e.key==='Enter'||e.key===' ') openMenu(); });
  mobileClose.addEventListener('click', closeMenu);
  document.querySelectorAll('.mobile-link').forEach(function(l) {
    l.addEventListener('click', closeMenu);
  });
  mobileNav.addEventListener('click', function(e) { if(e.target===mobileNav) closeMenu(); });
  document.addEventListener('keydown', function(e) { if(e.key==='Escape') closeMenu(); });

  /* ── Scroll animations (home page) ── */
  var homeObserver = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        homeObserver.unobserve(e.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('#nx-home .fade-up').forEach(function(el) {
    homeObserver.observe(el);
  });

  /* ── Active nav highlight on scroll (home only) ── */
  var sections = document.querySelectorAll('#nx-home section[id]');
  var navLinks = document.querySelectorAll('.nav-links a[onclick*="scrollToSection"]');
  window.addEventListener('scroll', function() {
    if (currentPage !== 'home') return;
    var current = '';
    sections.forEach(function(s) { if (window.scrollY >= s.offsetTop - 120) current = s.id; });
    navLinks.forEach(function(a) {
      var matches = a.getAttribute('onclick') && a.getAttribute('onclick').includes("'" + current + "'");
      a.style.color = matches ? 'var(--cyan)' : '';
    });
  }, { passive: true });

  /* ── Contact form ── */
  var form = document.getElementById('contactForm');
  var formNote = document.getElementById('formNote');
  var submitBtn = document.getElementById('submitBtn');

  if (form) {
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      var required = form.querySelectorAll('[required]');
      var valid = true;
      required.forEach(function(field) {
        if (!field.value.trim()) { field.style.borderColor = '#f87171'; valid = false; }
        else field.style.borderColor = '';
      });
      if (!valid) return;

      submitBtn.querySelector('span').textContent = 'Sending…';
      submitBtn.disabled = true;

      try {
        var res = await fetch('https://formspree.io/f/mkoynllz', {
          method: 'POST',
          body: new FormData(form),
          headers: { 'Accept': 'application/json' }
        });
        if (res.ok) {
          formNote.classList.add('show');
          form.reset();
          submitBtn.querySelector('span').textContent = 'Sent ✓';
        } else {
          submitBtn.querySelector('span').textContent = 'Error — email us directly';
          submitBtn.disabled = false;
        }
      } catch(err) {
        submitBtn.querySelector('span').textContent = 'Error — email us directly';
        submitBtn.disabled = false;
      }
    });
    form.querySelectorAll('input, textarea, select').forEach(function(field) {
      field.addEventListener('input', function() { field.style.borderColor = ''; });
    });
  }

  /* ── Code rain canvas ── */
  var canvas = document.getElementById('codeCanvas');
  if (canvas) {
    var ctx = canvas.getContext('2d');
    var cols, drops, rafId;
    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      cols = Math.floor(canvas.width / 22);
      drops = Array(cols).fill(1).map(function() { return Math.random() * -50; });
    }
    var chars = '01アイウエオカキクケコNEXUSZAMBIA<>{}[]|\\/-_=+';
    function draw() {
      ctx.fillStyle = 'rgba(6,14,26,0.06)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#00C8E8';
      ctx.font = '13px "Space Mono", monospace';
      for (var i = 0; i < drops.length; i++) {
        var char = chars[Math.floor(Math.random() * chars.length)];
        ctx.fillText(char, i * 22, drops[i] * 22);
        if (drops[i] * 22 > canvas.height && Math.random() > 0.975) drops[i] = 0;
        drops[i] += 0.4;
      }
      rafId = requestAnimationFrame(draw);
    }
    if (window.matchMedia('(min-width: 900px)').matches) {
      resize();
      draw();
      window.addEventListener('resize', function() {
        cancelAnimationFrame(rafId);
        resize();
        draw();
      }, { passive: true });
    }
  }

})();
</script>
